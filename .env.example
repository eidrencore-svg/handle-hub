NEXT_PUBLIC_APP_NAME=Handle Hub

# Optional — Steam Web API key (https://steamcommunity.com/dev/apikey)
# Without it, Steam uses the public community XML vanity probe.
STEAM_API_KEY=

# Optional — Xbox Live reservation check (true available/taken)
# Capture Authorization + reservationId (XUID) from an authenticated Xbox client.
XBOX_AUTHORIZATION=
XBOX_RESERVATION_ID=

# Optional — OpenXBL profile search (https://xbl.io) when reservation creds are absent
OPENXBL_API_KEY=

# Optional — X (Twitter) API v2 bearer token for user-by-username lookup
# Without it, falls back to a best-effort x.com profile HTTP probe.
X_BEARER_TOKEN=
# TWITTER_BEARER_TOKEN=   # alias for X_BEARER_TOKEN

# Optional — override Instagram web App ID used by the public profile probe
# INSTAGRAM_APP_ID=567067343352427
