NEXT_PUBLIC_APP_NAME=Handle Hub

# Supabase (project Handle-hub-v1)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — required to persist checks/searches (bypasses RLS).
# Get from Supabase Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# Optional — Steam Web API key (https://steamcommunity.com/dev/apikey)
STEAM_API_KEY=

# Optional — Xbox Live reservation check
XBOX_AUTHORIZATION=
XBOX_RESERVATION_ID=
OPENXBL_API_KEY=

# Optional — X (Twitter) API v2 bearer token
X_BEARER_TOKEN=
# TWITTER_BEARER_TOKEN=

# Optional — Instagram web App ID
# INSTAGRAM_APP_ID=567067343352427

# Optional — Twitch Helix app credentials
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optional — YouTube Data API v3 key
YOUTUBE_API_KEY=

# Optional — Reddit official API (app-only OAuth). Create a free app at
# https://www.reddit.com/prefs/apps — needed because Reddit blocks anonymous JSON from datacenter IPs.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Optional — salt for hashing client IPs in `searches.ip_hash` (raw IPs are never stored)
IP_HASH_SALT=
